<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>laserphile</groupId>
    <artifactId>chromatik-plugins</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Laserphile Chromatik Plugins</name>

    <!--
      Aggregator + parent for every Chromatik content package in this repo.

      Chromatik discovers packages by scanning ~/Chromatik/Packages/*.jar for a root
      lx.package file, so one jar is exactly one package. Each plugin therefore needs
      its own module, its own shade run, and its own lx.package. Everything that is
      identical across plugins (compiler settings, the provided LX dependencies, the
      lx.package resource filtering, the shade config, the install profile) lives here
      and is inherited, so a new plugin module is a ~15-line pom.

      See docs/ADDING-A-PLUGIN.md for the recipe.
    -->
    <!--
      chromatik-core first: the two plugins compile against it and resolve it from the reactor,
      so Maven has to build it before them. It also declares the dist-* profiles, which is why
      the build loop in CI still finds them when run from here.
    -->
    <modules>
        <module>packages/chromatik-core</module>
        <module>packages/chromatik-video</module>
        <module>packages/chromatik-screen</module>
        <module>packages/chromatik-shader</module>
        <module>packages/chromatik-mcp</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lx.version>1.2.1</lx.version>

        <!--
          Decode stack, used by plugins that bundle it. The platform natives are chosen by the
          dist-* profiles in each such module, which is where one jar per OS/arch comes from.
        -->
        <javacv.version>1.5.11</javacv.version>
        <ffmpeg.version>7.1-1.5.11</ffmpeg.version>

        <!--
          Pinned to the version LX itself depends on, so a plugin compiling against gson sees
          exactly the classes Chromatik will hand it at runtime. Bump this only when lx does.
        -->
        <gson.version>2.13.1</gson.version>

        <!--
          GL bindings for the shader plugin. Chromatik ships LWJGL core, GLFW and bgfx but not
          lwjgl-opengl, so that one module is bundled and the rest stay provided. The version has
          to track whatever GLX depends on: the bundled module links against the core classes
          Chromatik has already loaded, and a mismatch between them fails at runtime rather than
          at build time. Check glx's pom when bumping lx.version.
        -->
        <lwjgl.version>3.3.6</lwjgl.version>

        <maven-compiler-plugin.version>3.8.0</maven-compiler-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-shade-plugin.version>3.5.1</maven-shade-plugin.version>
    </properties>

    <!--
      LX / GLX are provided by the Chromatik runtime via its LXClassLoader, so they are
      scope=provided (compiled against, never bundled). All three resolve from Maven Central.
      glxstudio is only needed if we ever add custom device UI; kept here to match the
      official LXPackage template and because it is harmless at provided scope.

      Inherited by every module: a Chromatik plugin that does not compile against LX is
      not a Chromatik plugin.
    -->
    <dependencies>
        <dependency>
            <groupId>com.heronarts</groupId>
            <artifactId>lx</artifactId>
            <version>${lx.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.heronarts</groupId>
            <artifactId>glx</artifactId>
            <version>${lx.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.heronarts</groupId>
            <artifactId>glxstudio</artifactId>
            <version>${lx.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!--
      JavaCV is managed, not inherited: the version is pinned here so every module that decodes
      agrees on it, but only modules that declare the dependency pay for it. A plugin that does
      no decoding should not carry FFmpeg.

      The platform-specific ffmpeg and javacpp natives are NOT managed here, because a module's
      dist-* profile declares a different classifier per build and the Mac profile declares two
      at once. Those profiles read ${ffmpeg.version} and ${javacv.version} above, so versions
      still live in exactly one place.

      Only the natives for the target platform are pulled, never the all-OS *-platform
      aggregators. The default ffmpeg build is LGPL; the -gpl classifier variants are full GPL.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.bytedeco</groupId>
                <artifactId>javacv</artifactId>
                <version>${javacv.version}</version>
            </dependency>

            <!--
              Managed rather than inherited for the same reason as javacv: a plugin that never
              touches JSON should not have to think about it. Declared at provided scope by the
              modules that do, since Chromatik already ships gson on its own class path.
            -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Declared as plugins rather than pluginManagement so modules inherit the executions
      as well as the versions, and a new plugin module needs no <build> block at all.
      All three are harmless on this pom-packaging parent: shade skips pom projects, and
      both resources executions find nothing to copy at the repo root.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint</arg>
                        <arg>-Xpkginfo:always</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Filter lx.package so the @...@ build tokens are replaced with real Maven values. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>filter-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>resources</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <includes>
                                        <include>lx.package</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Uber-jar: bundle each module's compile-scope dependencies and any platform
              native; LX/GLX are provided so they stay out. No relocation, so the
              org/bytedeco/**/<platform>/ native resource paths stay verbatim (JavaCPP's
              Loader looks them up as classpath resources).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!--
                                          Both spellings. Chromatik scans every entry in a package
                                          jar and tries to load anything ending in .class, and a
                                          module descriptor is not one: it comes back as
                                          "not a class because access_flag ACC_MODULE is set",
                                          with a stack trace, at every startup. Harmless, but it
                                          is the first thing in the log and it looks like a fault.
                                          A multi-release jar hides a second copy per version.
                                        -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      `mvn -Pinstall install` copies every module's built jar into ~/Chromatik/Packages.
      Add `-pl :chromatik-<name>` to install a single plugin. Plain `mvn package` does not copy.
    -->
    <profiles>
        <profile>
            <id>install</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>${maven-resources-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>copy-files-on-build</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${user.home}/Chromatik/Packages</outputDirectory>
                                    <resources>
                                        <!--
                                          finalName rather than artifactId-version, so this also
                                          picks up the platform-suffixed jars a dist-* profile
                                          produces. It defaults to artifactId-version for a module
                                          that sets no finalName of its own.
                                        -->
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <include>${project.build.finalName}.jar</include>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
